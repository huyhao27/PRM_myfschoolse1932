<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MyfschoolWeb.SiteMaster" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - MyFSchool</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
    <link href="Content/site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua, đến nội dung chính</a>
    <form id="mainForm" runat="server">
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" href="Default.aspx" aria-label="MyFSchool - về Tổng quan">
                <span class="sidebar-logo"><img src="Content/fpt-logo.svg" alt="FPT Education" /></span>
                <span class="sidebar-brand-text">
                    <span class="sidebar-brand-name">MyFSchool</span>
                    <span class="sidebar-brand-sub"><asp:Literal ID="litPortalBadge" runat="server">Cổng quản lý</asp:Literal></span>
                </span>
            </a>

            <nav class="app-nav" aria-label="Menu chính">
                <div class="nav-group">
                    <p class="nav-group-label" id="ng-overview">Tổng quan</p>
                    <ul class="nav" aria-labelledby="ng-overview">
                        <li><a class="nav-link<%= Active("Default") %>" href="Default.aspx"<%= Cur("Default") %>><i class="fa-solid fa-gauge-high nav-icon" aria-hidden="true"></i><span>Tổng quan</span></a></li>
                    </ul>
                </div>
                <div class="nav-group">
                    <p class="nav-group-label" id="ng-training">Đào tạo</p>
                    <ul class="nav" aria-labelledby="ng-training">
                        <li><a class="nav-link<%= Active("ListStudent", "ViewStudent", "AddStudent", "EditStudent") %>" href="ListStudent.aspx"<%= Cur("ListStudent", "ViewStudent", "AddStudent", "EditStudent") %>><i class="fa-solid fa-user-graduate nav-icon" aria-hidden="true"></i><span>Học sinh / Tài khoản</span></a></li>
                        <li><a class="nav-link<%= Active("ListSchedule", "ViewSchedule") %>" href="ListSchedule.aspx"<%= Cur("ListSchedule", "ViewSchedule") %>><i class="fa-solid fa-calendar-days nav-icon" aria-hidden="true"></i><span>Thời khóa biểu</span></a></li>
                        <li><a class="nav-link<%= Active("ListGrade", "ViewGrade", "EditGrade", "AddGrade") %>" href="ListGrade.aspx"<%= Cur("ListGrade", "ViewGrade", "EditGrade", "AddGrade") %>><i class="fa-solid fa-book-bookmark nav-icon" aria-hidden="true"></i><span>Sổ điểm</span></a></li>
                    </ul>
                </div>
                <div class="nav-group">
                    <p class="nav-group-label" id="ng-work">Công việc</p>
                    <ul class="nav" aria-labelledby="ng-work">
                        <li><a class="nav-link<%= Active("ListRequest", "ViewRequest") %>" href="ListRequest.aspx"<%= Cur("ListRequest", "ViewRequest") %>><i class="fa-solid fa-envelope-open-text nav-icon" aria-hidden="true"></i><span>Đơn từ</span><%= PendingBadge() %></a></li>
                        <li><a class="nav-link<%= Active("ListClub", "ViewClub") %>" href="ListClub.aspx"<%= Cur("ListClub", "ViewClub") %>><i class="fa-solid fa-people-group nav-icon" aria-hidden="true"></i><span>Câu lạc bộ</span></a></li>
                    </ul>
                </div>
                <asp:PlaceHolder ID="phAdminNav" runat="server">
                    <div class="nav-group">
                        <p class="nav-group-label" id="ng-data">Dữ liệu</p>
                        <ul class="nav" aria-labelledby="ng-data">
                            <li><a class="nav-link<%= Active("ImportData") %>" href="ImportData.aspx"<%= Cur("ImportData") %>><i class="fa-solid fa-cloud-arrow-up nav-icon" aria-hidden="true"></i><span>Import dữ liệu</span></a></li>
                        </ul>
                    </div>
                </asp:PlaceHolder>
            </nav>
            <div class="sidebar-foot">Trường THPT FPT Hà Nội</div>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <div class="app-main">
            <header class="app-topbar" role="banner">
                <button type="button" class="icon-btn has-border sidebar-toggle" id="sidebarToggle" aria-controls="appSidebar" aria-expanded="false" aria-label="Mở menu" title="Menu">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <div class="topbar-title"><span class="crumb">MyFSchool / </span><%: Page.Title %></div>
                <div class="topbar-user">
                    <span class="user-avatar" aria-hidden="true"><asp:Literal ID="litUserIcon" runat="server"><i class="fa-solid fa-circle-user"></i></asp:Literal></span>
                    <span class="user-name"><asp:Literal ID="litUserName" runat="server" Text="Quản trị viên"></asp:Literal></span>
                    <asp:Literal ID="litUserBadge" runat="server"></asp:Literal>
                    <a class="icon-btn has-border" href="Login.aspx?logout=true" title="Đăng xuất" aria-label="Đăng xuất"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i></a>
                </div>
            </header>

            <main id="main-content" class="app-content" tabindex="-1">
                <div class="app-content-inner">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </main>

            <footer class="app-footer" role="contentinfo">
                &copy; <%: DateTime.Now.Year %> Trường THPT FPT Hà Nội &middot; MyFSchool - Quản trị học tập &amp; Sổ điểm điện tử
            </footer>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="Content/site.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
