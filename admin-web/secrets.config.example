<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to secrets.config (git-ignored) or let tools\gen-connection.ps1 write it from backend\.env. Never commit the real file. -->
<appSettings>
  <!-- Must equal JWT_SECRET in backend\.env so Node and C# tokens are interchangeable. -->
  <add key="JwtSecret" value="CHANGE_ME_same_as_JWT_SECRET_in_backend_.env" />
</appSettings>
